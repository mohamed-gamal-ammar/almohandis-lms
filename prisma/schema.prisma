// Al-Muhandis Platform - Database Schema
// Master Specification - PostgreSQL with Prisma ORM
// Phase 0: Project Foundation & Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  TEACHING_ASSISTANT
  STUDENT
  GUEST
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNLISTED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  COMPREHENSIVE
}

enum EngineeringDiscipline {
  CIVIL
  STRUCTURAL
  ARCHITECTURE
  ELECTRICAL
  MECHANICAL
  BIM
  PROJECT_MANAGEMENT
  GENERAL
}

enum ContentType {
  VIDEO
  PDF
  QUIZ
  ARTICLE
  CODE_ASSIGNMENT
}

enum PaymentProvider {
  PAYMOB
  STRIPE
  FAWRY
  KASHIER
  MOCK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum VideoProvider {
  BUNNY_STREAM
  MUX
  CLOUDFLARE_STREAM
  YOUTUBE
  DIRECT_HLS
}

enum VideoStatus {
  INITIALIZED
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

// --------------------------------------------------------
// USER & IDENTITY
// --------------------------------------------------------

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String
  role              UserRole        @default(STUDENT)
  isActive          Boolean         @default(true)
  isEmailVerified   Boolean         @default(false)
  isPhoneVerified   Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Profile & Relations
  profile           UserProfile?
  sessions          UserSession[]
  instructedCourses Course[]        @relation("CourseInstructor")
  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  payments          PaymentOrder[]
  quizSubmissions   QuizSubmission[]
  discussions       DiscussionThread[]
  replies           DiscussionReply[]
  reviews           Review[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

model UserProfile {
  id              String                @id @default(uuid())
  userId          String                @unique
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullNameArabic  String
  fullNameEnglish String?
  phoneNumber     String?
  avatarUrl       String?
  bio             String?
  discipline      EngineeringDiscipline @default(GENERAL)
  university      String?
  graduationYear  Int?
  syndicateId     String? // رقم كارنيه نقابة المهندسين
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// --------------------------------------------------------
// COURSES & CONTENT STRUCTURE
// --------------------------------------------------------

model Course {
  id              String                @id @default(uuid())
  titleArabic     String
  titleEnglish    String?
  slug            String                @unique
  summaryArabic   String
  descriptionArabic String
  discipline      EngineeringDiscipline @default(GENERAL)
  level           DifficultyLevel       @default(BEGINNER)
  status          CourseStatus          @default(DRAFT)
  priceAmount     Decimal               @default(0.0) @db.Decimal(10, 2)
  currency        String                @default("EGP")
  thumbnailUrl    String?
  promotionalVideoUrl String?
  instructorId    String
  instructor      User                  @relation("CourseInstructor", fields: [instructorId], references: [id])
  durationHours   Float                 @default(0.0)
  isPublished     Boolean               @default(false)
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Modules & Content
  modules         CourseModule[]
  enrollments     Enrollment[]
  reviews         Review[]
  orders          PaymentOrder[]

  @@index([slug])
  @@index([discipline])
  @@index([status])
  @@index([instructorId])
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleArabic String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]

  @@index([courseId, orderIndex])
}

model Lesson {
  id              String       @id @default(uuid())
  moduleId        String
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  titleArabic     String
  summaryArabic   String?
  type            ContentType  @default(VIDEO)
  orderIndex      Int          @default(0)
  durationMinutes Int          @default(0)
  isFreePreview   Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Details & Content
  videoAsset      VideoAsset?
  attachments     Attachment[]
  quiz            Quiz?
  progress        LessonProgress[]
  discussions     DiscussionThread[]

  @@index([moduleId, orderIndex])
}

model VideoAsset {
  id              String        @id @default(uuid())
  lessonId        String        @unique
  lesson          Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  provider        VideoProvider @default(BUNNY_STREAM)
  providerVideoId String
  hlsPlaybackUrl  String
  durationSeconds Int           @default(0)
  status          VideoStatus   @default(INITIALIZED)
  isDrmProtected  Boolean       @default(true)
  watermarkText   String?
  resolutionsJson String? // JSON array of available resolutions
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([providerVideoId])
}

model Attachment {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  titleArabic String
  fileUrl     String
  fileType    String // pdf, dwg, rvt, zip
  fileSizeBytes BigInt  @default(0)
  createdAt   DateTime @default(now())
}

// --------------------------------------------------------
// ENROLLMENT & PROGRESS
// --------------------------------------------------------

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  orderId    String?
  isActive   Boolean  @default(true)
  progressPct Float   @default(0.0)
  enrolledAt DateTime @default(now())
  expiresAt  DateTime?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted    Boolean  @default(false)
  lastPositionSec Int     @default(0)
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// --------------------------------------------------------
// PAYMENTS & ORDERS
// --------------------------------------------------------

model PaymentOrder {
  id            String          @id @default(uuid())
  orderNumber   String          @unique
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId      String
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("EGP")
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(PAYMOB)
  providerRef   String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transactions  PaymentTransaction[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id                String       @id @default(uuid())
  orderId           String
  order             PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerTxId      String
  amount            Decimal      @db.Decimal(10, 2)
  currency          String       @default("EGP")
  status            PaymentStatus
  rawPayload        String?      @db.Text
  createdAt         DateTime     @default(now())

  @@index([providerTxId])
  @@index([orderId])
}

model WebhookEventLog {
  id         String          @id @default(uuid())
  provider   PaymentProvider
  eventType  String
  signature  String?
  payload    String          @db.Text
  isHandled  Boolean         @default(false)
  handledAt  DateTime?
  error      String?
  createdAt  DateTime        @default(now())

  @@index([provider, eventType])
}

// --------------------------------------------------------
// QUIZZES & ASSESSMENTS
// --------------------------------------------------------

model Quiz {
  id           String           @id @default(uuid())
  lessonId     String           @unique
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  titleArabic  String
  passingScore Int              @default(70)
  timeLimitMin Int?
  questions    QuizQuestion[]
  submissions  QuizSubmission[]
}

model QuizQuestion {
  id          String   @id @default(uuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  promptArabic String
  optionsJson String   // JSON array of options
  correctOptionIndex Int
  explanationArabic String?
  orderIndex  Int      @default(0)
}

model QuizSubmission {
  id         String   @id @default(uuid())
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Int
  isPassed   Boolean
  answersJson String  @db.Text
  submittedAt DateTime @default(now())

  @@index([quizId, userId])
}

// --------------------------------------------------------
// COMMUNITY & REVIEWS
// --------------------------------------------------------

model Review {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      @default(5)
  comment     String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([courseId, userId])
}

model DiscussionThread {
  id          String            @id @default(uuid())
  lessonId    String
  lesson      Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String
  isAnswered  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  replies     DiscussionReply[]

  @@index([lessonId])
}

model DiscussionReply {
  id        String           @id @default(uuid())
  threadId  String
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  isSolution Boolean         @default(false)
  createdAt DateTime         @default(now())
}

// --------------------------------------------------------
// SYSTEM, AUDITING & NOTIFICATIONS
// --------------------------------------------------------

model Notification {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     NotificationChannel @default(IN_APP)
  titleArabic String
  bodyArabic  String
  actionUrl   String?
  isRead      Boolean             @default(false)
  createdAt   DateTime            @default(now())

  @@index([userId, isRead])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  isEnabled   Boolean  @default(false)
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  metadata   String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, resource])
  @@index([userId])
}
