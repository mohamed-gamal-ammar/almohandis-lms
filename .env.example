# Core Required Environment Variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/al_muhandis_db?schema=public"
JWT_SECRET="al_muhandis_jwt_secret_dev_key_phase0"

# Video Provider Selection (none | bunny | mux | cloudflare | youtube)
VIDEO_PROVIDER=none

# Bunny.net Stream (Required only when VIDEO_PROVIDER=bunny)
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=

# Mux Video (Required only when VIDEO_PROVIDER=mux)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=

# Cloudflare Stream (Required only when VIDEO_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY=

# Payment Provider Selection (none | paymob | stripe | fawry)
PAYMENT_PROVIDER=none

# Paymob Gateway (Required only when PAYMENT_PROVIDER=paymob)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=

# Stripe Gateway (Required only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


